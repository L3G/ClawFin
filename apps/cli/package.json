{
  "name": "@l3g/clawfin",
  "version": "0.2.0",
  "description": "ClawFin CLI — local-first Plaid-to-MCP bridge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/L3G/ClawFin.git"
  },
  "homepage": "https://github.com/L3G/ClawFin",
  "bugs": {
    "url": "https://github.com/L3G/ClawFin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "clawfin": "bin/clawfin.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "bin/",
    "static/"
  ],
  "scripts": {
    "build": "tsup && mkdir -p static/link-ui && cp -r ../link-ui/public/* static/link-ui/",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.1",
    "plaid": "^29.0.0",
    "prompts": "^2.4.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@clawfin/finance-service": "*",
    "@clawfin/mcp-server": "*",
    "@clawfin/shared": "*",
    "@clawfin/vault": "*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
